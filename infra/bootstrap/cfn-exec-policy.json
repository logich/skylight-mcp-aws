{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": [
        "arn:aws:lambda:us-east-2:${ACCOUNT}:function:skylight-mcp*"
      ]
    },
    {
      "Sid": "ApiGatewayList",
      "Effect": "Allow",
      "Action": "apigateway:GET",
      "Resource": "arn:aws:apigateway:us-east-2::/apis"
    },
    {
      "Sid": "ApiGatewayCreateTagged",
      "Effect": "Allow",
      "Action": "apigateway:POST",
      "Resource": "arn:aws:apigateway:us-east-2::/apis",
      "Condition": { "StringEquals": { "aws:RequestTag/project": "skylight-mcp" } }
    },
    {
      "Sid": "ApiGatewayOwnApiOnly",
      "Effect": "Allow",
      "Action": "apigateway:*",
      "Resource": [
        "arn:aws:apigateway:us-east-2::/apis/${API_ID}",
        "arn:aws:apigateway:us-east-2::/apis/${API_ID}/*",
        "arn:aws:apigateway:us-east-2::/tags/*${API_ID}*"
      ]
    },
    {
      "Sid": "CognitoCreateTaggedPool",
      "Effect": "Allow",
      "Action": "cognito-idp:CreateUserPool",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-2", "aws:RequestTag/project": "skylight-mcp" }
      }
    },
    {
      "Sid": "CognitoOwnPoolOnly",
      "Effect": "Allow",
      "Action": "cognito-idp:*",
      "Resource": "arn:aws:cognito-idp:us-east-2:${ACCOUNT}:userpool/${POOL_ID}"
    },
    {
      "Sid": "CognitoReadOnlyWithoutResourceLevelSupport",
      "Effect": "Allow",
      "Action": ["cognito-idp:DescribeUserPoolDomain", "cognito-idp:ListUserPools"],
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Sid": "NeverRemoveTheAccessTag",
      "Effect": "Deny",
      "Action": "kms:UntagResource",
      "Resource": "*",
      "Condition": { "ForAnyValue:StringEquals": { "aws:TagKeys": "project" } }
    },
    {
      "Sid": "LogGroups",
      "Effect": "Allow",
      "Action": "logs:*",
      "Resource": [
        "arn:aws:logs:us-east-2:${ACCOUNT}:log-group:/aws/lambda/skylight-mcp*",
        "arn:aws:logs:us-east-2:${ACCOUNT}:log-group:/aws/apigateway/skylight-mcp*"
      ]
    },
    {
      "Sid": "LogDeliveryForApiAccessLogs",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:CreateLogDelivery",
        "logs:GetLogDelivery",
        "logs:UpdateLogDelivery",
        "logs:DeleteLogDelivery",
        "logs:ListLogDeliveries",
        "logs:DescribeResourcePolicies"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LogsResourcePolicyFirstDeployOnly",
      "Effect": "${FIRST_DEPLOY_EFFECT}",
      "Action": "logs:PutResourcePolicy",
      "Resource": "*"
    },
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:us-east-2:${ACCOUNT}:table/SkylightMcp*"
    },
    {
      "Sid": "KmsCreateTaggedKey",
      "Effect": "Allow",
      "Action": "kms:CreateKey",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "aws:RequestedRegion": "us-east-2", "aws:RequestTag/project": "skylight-mcp" }
      }
    },
    {
      "Sid": "KmsManageTaggedKeysNoDataAccess",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:PutKeyPolicy",
        "kms:EnableKeyRotation",
        "kms:GetKeyRotationStatus",
        "kms:ScheduleKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:ListResourceTags",
        "kms:CreateAlias",
        "kms:UpdateAlias",
        "kms:DeleteAlias"
      ],
      "Resource": "arn:aws:kms:us-east-2:${ACCOUNT}:key/*",
      "Condition": { "StringEquals": { "aws:ResourceTag/project": "skylight-mcp" } }
    },
    {
      "Sid": "KmsGrantForDynamoDBTableEncryption",
      "Effect": "Allow",
      "Action": "kms:CreateGrant",
      "Resource": "arn:aws:kms:us-east-2:${ACCOUNT}:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/project": "skylight-mcp",
          "kms:ViaService": "dynamodb.us-east-2.amazonaws.com"
        },
        "Bool": { "kms:GrantIsForAWSResource": "true" }
      }
    },
    {
      "Sid": "KmsOwnAliases",
      "Effect": "Allow",
      "Action": ["kms:CreateAlias", "kms:UpdateAlias", "kms:DeleteAlias"],
      "Resource": "arn:aws:kms:us-east-2:${ACCOUNT}:alias/skylight-mcp*"
    },
    {
      "Sid": "KmsListAliases",
      "Effect": "Allow",
      "Action": "kms:ListAliases",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Sid": "SchedulerSnsAlarmsCodeDeploy",
      "Effect": "Allow",
      "Action": ["scheduler:*", "sns:*", "cloudwatch:*", "codedeploy:*"],
      "Resource": [
        "arn:aws:scheduler:us-east-2:${ACCOUNT}:schedule/*/SkylightMcp*",
        "arn:aws:scheduler:us-east-2:${ACCOUNT}:schedule-group/*",
        "arn:aws:sns:us-east-2:${ACCOUNT}:SkylightMcp*",
        "arn:aws:cloudwatch:us-east-2:${ACCOUNT}:alarm:SkylightMcp*",
        "arn:aws:codedeploy:us-east-2:${ACCOUNT}:application:SkylightMcp*",
        "arn:aws:codedeploy:us-east-2:${ACCOUNT}:deploymentgroup:SkylightMcp*",
        "arn:aws:codedeploy:us-east-2:${ACCOUNT}:deploymentconfig:*"
      ]
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": ["budgets:*"],
      "Resource": "arn:aws:budgets::${ACCOUNT}:budget/SkylightMcp*"
    },
    {
      "Sid": "IamRolesCreateOrGrantOnlyWithBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:aws:iam::${ACCOUNT}:role/SkylightMcp-*",
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${ACCOUNT}:policy/SkylightMcpRoleBoundary"
        }
      }
    },
    {
      "Sid": "IamRolesManageOwn",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRole",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::${ACCOUNT}:role/SkylightMcp-*"
    },
    {
      "Sid": "CdkBootstrapVersionAndAssets",
      "Effect": "Allow",
      "Action": ["ssm:GetParameters", "ssm:GetParameter", "s3:GetObject"],
      "Resource": [
        "arn:aws:ssm:us-east-2:${ACCOUNT}:parameter/cdk-bootstrap/hnb659fds/version",
        "arn:aws:ssm:us-east-2:${ACCOUNT}:parameter/skylight-mcp/*",
        "arn:aws:s3:::cdk-hnb659fds-assets-${ACCOUNT}-us-east-2/*"
      ]
    }
  ]
}
